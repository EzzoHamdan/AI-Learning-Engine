# =============================================================================
# AI Learning Engine — configuration
# =============================================================================
#
# Copy to `.env` and edit. Everything here is optional: the app runs on its
# built-in defaults. Every setting maps to a field in
# src/learning_engine/settings.py — that file is the source of truth.
#
# 💸 YOU DO NOT HAVE TO PAY TO RUN THIS. Three of the four options below cost
#    nothing, and none of them need a credit card.
#
# 🚀 QUICK START — pick one:
#
# Option 1 (FREE, private): Local AI
#   1. Install Ollama from https://ollama.ai
#   2. Run: ollama pull gemma2:2b
#   3. Leave the settings below as they are
#   No key, no limit, no network — but it runs on your own CPU/GPU.
#
# Option 2 (FREE tier): Google AI Studio
#   1. Get a key from https://aistudio.google.com/app/apikey
#   2. Set GOOGLE_AI_API_KEY below
#   3. Set LLM__DEFAULT_PROVIDER=google
#
# Option 3 (FREE tier): OpenRouter — many models behind one key
#   1. Get a key from https://openrouter.ai/keys
#   2. Set OPENROUTER_API_KEY below
#   3. Set LLM__DEFAULT_PROVIDER=openrouter
#   Defaults to a `:free` model, so this key is not billable. Any model whose
#   slug ends in `:free` stays free; drop the suffix and it starts costing.
#
# Option 4: OpenAI (pay-per-use)
#   1. Get a key from https://platform.openai.com/api-keys
#   2. Set OPENAI_API_KEY below
#   3. Set LLM__DEFAULT_PROVIDER=openai
#
# Options 2 and 3 cap how many requests you get per day, and both providers
# change those caps — check their own limits pages rather than trusting a number
# written down here. Using both gives you two independent daily allowances.
#
# =============================================================================

# -----------------------------------------------------------------------------
# API keys — these keep their conventional, unprefixed names
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""

# -----------------------------------------------------------------------------
# LLM settings (prefix LLM__, nested sections separated by __)
# -----------------------------------------------------------------------------

# Which provider the app starts on: ollama | google | openai | openrouter
LLM__DEFAULT_PROVIDER=ollama

# Local AI (Ollama). Never include a /v1 suffix — the client adds it.
LLM__OLLAMA__HOST=127.0.0.1
LLM__OLLAMA__PORT=11434
LLM__OLLAMA__CHAT_MODEL="gemma2:2b"
# LLM__OLLAMA__SCORING_MODEL=""        # blank → reuse the chat model

# Google AI (Gemini, via its OpenAI-compatible endpoint)
# LLM__GOOGLE__CHAT_MODEL="gemini-2.5-flash"
# LLM__GOOGLE__SCORING_MODEL="gemini-2.5-flash"
# LLM__GOOGLE__BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# OpenRouter (one key, many models). Keep the `:free` suffix to stay unbilled.
# LLM__OPENROUTER__CHAT_MODEL="google/gemma-4-31b-it:free"
# LLM__OPENROUTER__SCORING_MODEL=""    # blank → reuse the chat model
# LLM__OPENROUTER__BASE_URL="https://openrouter.ai/api/v1"

# OpenAI
# LLM__OPENAI__CHAT_MODEL="gpt-4o-mini"
# LLM__OPENAI__SCORING_MODEL="gpt-4o-mini"
# LLM__OPENAI__BASE_URL=""             # blank → the SDK default

# Generation knobs
# LLM__GENERATION_TEMPERATURE=0.7      # quiz / question generation
# LLM__SCORING_TEMPERATURE=0.3         # open-ended answer scoring
# LLM__SUMMARY_TEMPERATURE=0.5         # long-document summarization
# LLM__MATERIALS_TEMPERATURE=0.3       # study materials (lower = more consistent)
# LLM__GENERATION_MAX_TOKENS=2000
# LLM__SCORING_MAX_TOKENS=700
# LLM__REQUEST_TIMEOUT=120             # seconds, per generation call
# LLM__PROBE_TIMEOUT=5                 # seconds, per health check

# -----------------------------------------------------------------------------
# Quiz settings (prefix QUIZ__)
# -----------------------------------------------------------------------------
# QUIZ__MIN_QUESTIONS=3
# QUIZ__MAX_QUESTIONS=15
# QUIZ__DEFAULT_QUESTIONS=5
# QUIZ__SUMMARY_THRESHOLD=5000         # characters; longer documents get summarized first
# QUIZ__MAX_UPLOAD_MB=50
# QUIZ__SUPPORTED_FILE_TYPES='["pdf", "docx", "pptx"]'   # JSON when set from the environment

# -----------------------------------------------------------------------------
# App settings (prefix APP__; these three also accept their short legacy names)
# -----------------------------------------------------------------------------
DEBUG=false

# Set to true only when hosting the app (e.g. Streamlit Cloud). Leave false locally.
DEPLOYED=false

# Where persistent analytics are stored (default: ~/.learning_engine/analytics.db).
# Uncomment to override — handy for testing or a shared/portable data location.
# LEARNING_ENGINE_DB="/path/to/analytics.db"

# APP__TITLE="📚 AI Interactive Quiz & Study Materials Generator"

# -----------------------------------------------------------------------------
# Deprecated (still honored, but prefer the names above)
# -----------------------------------------------------------------------------
# LOCAL_AI_MODEL / LOCAL_AI_HOST / LOCAL_AI_PORT  → LLM__OLLAMA__*
# USE_LOCAL_AI / USE_GOOGLE_AI / USE_OPENAI       → LLM__DEFAULT_PROVIDER
